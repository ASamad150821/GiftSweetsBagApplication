# Local dev: matches docker-compose.yml. In production (Neon), Neon gives you this string directly.
DATABASE_URL="postgresql://giftbags:giftbags@localhost:5432/giftbags"

# Same connection, pointed at a second local database used only by the test suite.
# Create it once with: docker compose exec postgres createdb -U giftbags giftbags_test
TEST_DATABASE_URL="postgresql://giftbags:giftbags@localhost:5432/giftbags_test"

# Generate a real one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# The frontend's origin — Vite's dev server by default.
CORS_ORIGIN="http://localhost:5173"
